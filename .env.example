# ==============================================================================
# CONFIGURACIÓN SUPABASE - QUIMICORP TALENT
# ==============================================================================
PORT=5000

# URL de tu proyecto Supabase (Ej: https://xyzcompany.supabase.co)
SUPABASE_URL=

# Service Role Key (Para operaciones seguras del backend y cálculo seguro de notas)
SUPABASE_SERVICE_ROLE_KEY=

# Clave Anon / Pública (opcional en backend si se usa service role)
SUPABASE_ANON_KEY=

# Clave secreta para panel de evaluador / admin
ADMIN_SECRET_KEY=admin123
